#!/usr/bin/env bash
# Install only. Pairing and timer activation are separate actions.
set -euo pipefail
unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
source_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
mkdir -p "$unit_dir"
for unit in ftpu-files.service ftpu-files.timer ftpu-files-session.target; do
    ln -sfn "$source_dir/$unit" "$unit_dir/$unit"
done
if [[ -n ${WSL_DISTRO_NAME:-} ]]; then
    mkdir -p "$unit_dir/ftpu-files.service.d"
    cat > "$unit_dir/ftpu-files.service.d/wslg.conf" <<'EOF'
[Unit]
After=wslg-session.service

[Service]
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
EOF
fi
if [[ ${CI:-} != true && -n ${XDG_RUNTIME_DIR:-} ]] && command -v systemctl >/dev/null; then
    systemctl --user daemon-reload
fi
printf '%s\n' 'ftpu-files installed. Synchronization remains opt-in; see dotfiles-linux/docs/ftpu-files.md.'
