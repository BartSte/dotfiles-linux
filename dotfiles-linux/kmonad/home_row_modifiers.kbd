(defcfg
  ;; For Linux
  input  (device-file "/dev/input/by-path/platform-i8042-serio-0-event-kbd")
  output (uinput-sink "My KMonad output")
  
  ;; Comment this if you want unhandled events not to be emitted
  fallthrough true
  
  ;; Set this to false to disable any command-execution in KMonad
  allow-cmd true
)

;; Match the Atreus firmware holds: Tab = numbers, Space = navigation,
;; Enter = symbols, F = function keys, Backspace = shortcuts.
;; Shortcuts use the left half: P = play/pause, B = back (previous track),
;; F = forward (next track), S = silence (mute). Taps retain their base action.
;; For Meta + number, hold A and Tab, then press a right-hand digit.
;; The physical bottom-row keys emit Escape, Tab, Space, Backspace, Enter, Delete.
(defsrc
      q w e r t y u i o p
      a s d f g h j k l ;
 lsft z x c v b n m , . /
    lmet lalt space bspc ralt rctl
)

(defalias
    ma (tap-hold-next-release 200 a lmet)
    ar (tap-hold-next-release 200 r lalt)
    ss (tap-hold-next-release 200 s lsft)
    ct (tap-hold-next-release 200 t lctl)

    cn (tap-hold-next-release 200 n rctl)
    se (tap-hold-next-release 200 e rsft)
    ai (tap-hold-next-release 200 i lalt)
    mo (tap-hold-next-release 200 o rmet)

    eq (tap-macro space = space)

    num_tab (tap-hold-next-release 200 tab (layer-toggle numpad))
    nav_space (tap-hold-next-release 200 space (layer-toggle navigation_right))
    shortcuts_bspc (tap-hold-next-release 200 bspc (layer-toggle shortcuts))
    sym_ret (tap-hold-next-release 200 return (layer-toggle symbols))
    fk_f (tap-hold-next-release 200 f (layer-toggle fkeys))
    mac_d (tap-hold-next-release 200 d (layer-toggle macroright))
    mac_h (tap-hold-next-release 200 h (layer-toggle macroleft))
)

(deflayer homerowmods
    q   w   @fk_f   p       b      j   l        u       y   ;
    @ma @ar @ss     @ct     g      m   @cn      @se     @ai @mo
    _   z   x       c       @mac_d v  k @mac_h  ,       .   /
              esc @num_tab @nav_space @shortcuts_bspc @sym_ret del
)

(deflayer navigation_right
    _    _    _    _    _  Home     PageDown  PageUp  End       _
    lmet lalt lsft lctl _  KeyLeft  KeyDown   KeyUp   KeyRight  _
    _    _    _    _    _  _        _         _       _         _ _
         _ _ _ _ _ _
)

(deflayer shortcuts
    _ _ KeyNextSong KeyPlayPause KeyPreviousSong _ _ _ _ _
    _ _ KeyMute     _            _               _ _ _ _ _
    _ _ _ _ _ _ _ _ _ _ _
         _ _ _ _ _ _
)

(deflayer numpad
     _  _  _  _  _  *  7  8  9  +
     lmet lalt lsft lctl _  \  4  5  6  -
  _  _  _  _  _  _  |  1  2  3  &
              _  _  space  =  0  ,
)

(deflayer symbols
     !  @  #  $  %  _  _  _  _  _
     {  [  \( '  `  _  rctl rsft ralt rmet
  _  }  ]  \) "  ~  _  _  _  _  _
              _ ^ \_ _ _ _
)

(deflayer fkeys
     _    _    _    _    _  pause F7 F8 F9 F10
     lmet lalt lsft lctl _  slck  F4 F5 F6 F11
  _  _    _    _    _    _  ins   F1 F2 F3 F12
                _  _  _  _  _  _
)

(deflayer macroright
  _ _ _ _ _ _ _ _ _ _ 
  _ _ _ _ _ _ _ _ _ _ 
 _ _ _ _ _ _ _ _ _ _ _ 
       _ _ @eq _ _ _
)

(deflayer macroleft
  _ _ _ _ _ _ _ _ _ _ 
  _ _ _ _ _ _ _ _ _ _ 
 _ _ _ _ _ _ _ _ _ _ _ 
       _ _ _ _ _ _
)
