#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'HELP'
Usage: open [options] [--] [path[:line[:column]] | url]

Open one URL or file. An argument takes precedence over standard input.
Line and column numbers start at 1. Existing filenames take precedence over
location suffixes. Programs run in the foreground and their exit status is
returned to the caller.

Options:
    --linpath       Convert Windows input paths to Linux paths under WSL.
    --winpath       Use Windows paths for local browser files under WSL.
                    Linux tools always receive Linux paths.
    -l, --log FILE  Append debug messages to FILE.
    -q, --quiet     Suppress terminal output, including program output.
    -v, --verbose   Show debug messages on standard error.
    -h, --help      Show this help and exit.
    --             Treat the remaining argument as a path or URL.

WSLBROWSER and LINBROWSER each name one browser executable, without arguments.
Under WSL, WSLBROWSER takes precedence. Otherwise, LINBROWSER is used.
OPEN_LOG_FILE and OPEN_LOG_LEVEL (quiet or verbose) set logging defaults.
HELP
}

log() {
    local level=$1 message=$2
    if [[ -n ${log_file:-} ]]; then
        printf '%s: %s\n' "$level" "$message" >> "$log_file"
    fi
    if [[ ${OPEN_LOG_LEVEL:-} != quiet ]] &&
        [[ $level == error || ${OPEN_LOG_LEVEL:-} == verbose ]]; then
        printf 'open: %s\n' "$message" >&2
    fi
}

fail() {
    log error "$1"
    exit 1
}

parse_arguments() {
    local positional=false options=true
    to_open=''
    linpath=false
    winpath=false
    while (($#)); do
        if $options; then
            case $1 in
                -h | --help) usage; exit 0 ;;
                --linpath) linpath=true; shift; continue ;;
                --winpath) winpath=true; shift; continue ;;
                -l | --log)
                    [[ $# -ge 2 && -n $2 && $2 != -* ]] ||
                        fail "$1 requires a log filename."
                    OPEN_LOG_FILE=$2
                    shift 2
                    continue
                    ;;
                -q | --quiet) OPEN_LOG_LEVEL=quiet; shift; continue ;;
                -v | --verbose) OPEN_LOG_LEVEL=verbose; shift; continue ;;
                --) options=false; shift; continue ;;
                -*) fail "Unknown option: $1" ;;
            esac
        fi
        ! $positional || fail 'Provide only one path or URL.'
        to_open=$1
        positional=true
        shift
    done
    if $linpath && $winpath; then
        fail 'Use only one of --linpath and --winpath.'
    fi
    if ! $positional; then
        [[ ! -t 0 ]] || fail 'Provide a path or URL as an argument or through standard input.'
        to_open=$(cat)
    fi
    [[ -n $to_open ]] || fail 'The path or URL is empty.'
}

# Remove one pair of surrounding quotes. Preserve quotes inside filenames.
strip_quotes() {
    if [[ $path == \"*\" || $path == \'*\' ]]; then
        path=${path:1:${#path}-2}
    fi
}

parse_location() {
    path=$to_open
    line=1
    column=1
    if $wsl && [[ ! -e $path && ! -L $path ]]; then
        strip_quotes
    fi
    # A literal filename such as report:2026 takes precedence over a suffix.
    if [[ ! -e $path && ! -L $path ]]; then
        if [[ $path =~ ^(.*):([0-9]+):([0-9]*)$ ]]; then
            path=${BASH_REMATCH[1]}
            line=${BASH_REMATCH[2]}
            column=${BASH_REMATCH[3]:-1}
        elif [[ $path =~ ^(.*):([0-9]+)$ ]]; then
            path=${BASH_REMATCH[1]}
            line=${BASH_REMATCH[2]}
        fi
    fi
    # Normalize decimal numbers without shell arithmetic or octal conversion.
    [[ ! $line =~ ^0+$ && ! $column =~ ^0+$ ]] ||
        fail 'Line and column numbers must be greater than zero.'
    line=${line#"${line%%[!0]*}"}
    column=${column#"${column%%[!0]*}"}
    if $wsl; then
        if [[ ! -e $path && ! -L $path ]]; then
            strip_quotes
        fi
        if $linpath || $winpath; then
            if [[ $path =~ ^[[:alpha:]]:[\\/] || $path == \\\\* || $path == //* ]]; then
                path=$(wslpath -ua "${path//\\//}") || fail 'Windows path conversion failed.'
            fi
        fi
    fi
    [[ -n $path ]] || fail 'The file path is empty.'
}

run_program() {
    local status
    command -v -- "$1" >/dev/null 2>&1 || fail "Program not found: $1"
    log debug "Run: $1"
    if "$@"; then
        return 0
    else
        status=$?
        log error "$1 failed with status $status."
        return "$status"
    fi
}

open_url() {
    local target=$1 local_file=${2:-false} browser
    if $wsl && [[ -n ${WSLBROWSER:-} ]]; then
        browser=$WSLBROWSER
        if $local_file; then
            target=$(wslpath -ma "$target") || fail 'Browser path conversion failed.'
        fi
    elif [[ -n ${LINBROWSER:-} ]]; then
        browser=$LINBROWSER
        if $wsl && $winpath && $local_file; then
            target=$(wslpath -ma "$target") || fail 'Browser path conversion failed.'
        fi
    else
        fail 'No browser configured. Set LINBROWSER or, under WSL, WSLBROWSER.'
    fi
    run_program "$browser" "$target"
}

open_text() {
    local shell_path vim_path source session panes id window window_index pane_index command
    local editor='' editor_window='' editor_index='' editor_pane=''
    if [[ -z ${TMUX:-} ]]; then
        run_program nvim -c "call cursor($line, $column)" -- "$path"
        return
    fi
    source=${TMUX_PANE:-$(tmux display-message -p '#{pane_id}')}
    session=$(tmux display-message -p -t "$source" '#{session_id}') ||
        fail 'Cannot find the current tmux session.'
    panes=$(tmux list-panes -s -t "$source" -F \
        '#{pane_id} #{window_id} #{window_index} #{pane_index} #{pane_current_command}') ||
        fail 'Cannot list tmux panes.'
    while read -r id window window_index pane_index command; do
        [[ $command == nvim || $command == vim ]] || continue
        if [[ -z $editor || $id == "$source" ]]; then
            editor=$id
            editor_window=$window
            editor_index=$window_index
            editor_pane=$pane_index
        fi
        [[ $id != "$source" ]] || break
    done <<< "$panes"
    if [[ -n $editor ]]; then
        # key2pane keeps the raw path for Codex. Its shell and Vim actions use
        # separately escaped arguments from key2pane/config.json.
        printf -v shell_path '%q' "$path"
        vim_path=${path//\\/\\\\}
        vim_path=${vim_path//\"/\\\"}
        vim_path=${vim_path//$'\n'/\\n}
        vim_path=${vim_path//$'\r'/\\r}
        vim_path=${vim_path//$'\t'/\\t}
        vim_path=${vim_path//$'\e'/\\e}
        run_program key2pane --loglevel WARNING -s "$session" -w "$editor_index" -i "$editor_pane" -- \
            "$path" "$line" "$column" "$shell_path" "\"$vim_path\""
        tmux select-window -t "$editor_window"
        tmux select-pane -t "$editor"
    else
        command -v nvim >/dev/null 2>&1 || fail 'Program not found: nvim'
        run_program tmux split-window -h -t "$source" -c "$PWD" \
            nvim -c "call cursor($line, $column)" -- "$path"
    fi
}

open_file() {
    local mime
    parse_location
    [[ -f $path ]] || fail "Not a regular file: $path"
    # Absolute paths protect leading dashes and resolve tmux pane cwd differences.
    [[ $path == /* ]] || path="$PWD/$path"
    mime=$(file --mime-type -Lb -- "$path") || fail "Cannot detect file type: $path"
    log debug "File: $path ($mime), line $line, column $column"
    case $mime in
        image/*) run_program imv "$path" ;;
        application/pdf) run_program zathura "$path" ;;
        text/html | application/xhtml+xml) open_url "$path" true ;;
        application/x-sc) TERM=xterm-256color run_program sc-im "$path" ;;
        text/* | inode/x-empty | application/x-empty | application/json | \
        application/*+json | application/xml | application/*+xml | \
        application/javascript | application/x-javascript | application/x-shellscript | \
        application/toml | application/yaml | application/x-yaml | application/sql)
            open_text
            ;;
        *) fail "Unsupported file type: $mime ($path)" ;;
    esac
}

main() {
    local wsl=false
    if [[ -n ${OPEN_LOG_FILE:-} ]]; then
        if ! { mkdir -p -- "$(dirname -- "$OPEN_LOG_FILE")" && : >> "$OPEN_LOG_FILE"; }; then
            fail "Cannot write log file: $OPEN_LOG_FILE"
        fi
        log_file=$OPEN_LOG_FILE
    fi
    if [[ -n ${WSL_DISTRO_NAME:-}${WSL_INTEROP:-} ]] || grep -qi microsoft /proc/version; then
        wsl=true
    fi
    log debug "Input: $to_open"
    if [[ $to_open =~ ^[[:alpha:]][[:alnum:]+.-]*:// || $to_open == www.* || $to_open == mailto:* ]]; then
        open_url "$to_open"
    else
        open_file
    fi
}

log_file=''
parse_arguments "$@"
if [[ ${OPEN_LOG_LEVEL:-} == quiet ]]; then
    main >/dev/null 2>&1
else
    main
fi
