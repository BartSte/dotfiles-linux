#!/usr/bin/env bash

if ! command -v codex >/dev/null 2>&1; then
    printf '%s\n' 'codex-commit: codex executable not found on PATH' >&2
    exit 127
fi

if ! command -v git >/dev/null 2>&1; then
    printf '%s\n' 'codex-commit: git executable not found on PATH' >&2
    exit 127
fi

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    printf '%s\n' 'codex-commit: current directory is not inside a Git repository' >&2
    exit 1
fi

if git diff --cached --quiet --; then
    printf '%s\n' 'codex-commit: no staged changes' >&2
    exit 1
else
    staged_status=$?
fi

if (( staged_status > 1 )); then
    printf '%s\n' 'codex-commit: could not inspect staged changes' >&2
    exit "$staged_status"
fi

exec codex exec \
    --ephemeral \
    --model gpt-6-luna \
    --config model_reasoning_effort=low \
    '$commit Commit the complete set of currently staged changes using git. Split it into multiple focused commits when it contains independently reversible logical changes. Include every initially staged change, include no initially unstaged or untracked content, and do not push.'
