#!/usr/bin/env bash
set -euo pipefail

layout_hook='/home/barts/dotfiles-linux/bin/tmux-project-layout "$name" "$directory"'
tmux_session_args=()
extra_hooks=()

while (($#)); do
    case "$1" in
        --hook)
            if [[ $# -lt 2 ]]; then
                printf 'tsp: --hook requires an argument\n' >&2
                exit 2
            fi
            extra_hooks+=("$2")
            shift 2
            ;;
        --hook=*)
            extra_hooks+=("${1#--hook=}")
            shift
            ;;
        *)
            tmux_session_args+=("$1")
            shift
            ;;
    esac
done

if ((${#tmux_session_args[@]} == 0)); then
    selected_directory=$(/home/barts/dotfiles-linux/bin/tsp-picker) || exit 0
    [[ -n "$selected_directory" ]] || exit 0
    tmux_session_args+=("$selected_directory")
fi

combined_hook=
if ((${#extra_hooks[@]})); then
    for extra_hook in "${extra_hooks[@]}"; do
        if [[ -z "$combined_hook" ]]; then
            combined_hook="$extra_hook"
        else
            combined_hook="$combined_hook; $extra_hook"
        fi
    done
    combined_hook="$combined_hook; $layout_hook"
else
    combined_hook="$layout_hook"
fi

# Nested PR worktrees need the project name to distinguish identical PR numbers.
if ((${#tmux_session_args[@]} == 1)) && [[ -f "${tmux_session_args[0]}/.git" ]]; then
    directory=$(realpath "${tmux_session_args[0]}")
    project_directory=$(dirname "$directory")
    worktree_root=$(dirname "$project_directory")
    main_directory=$(git -C "$directory" worktree list --porcelain | sed -n '1s/^worktree //p')
    if [[ "${worktree_root##*/}" == worktrees &&
        "${project_directory##*/}" == "${main_directory##*/}" ]]; then
        name=$(printf '%s--%s' "${project_directory##*/}" "${directory##*/}" | tr . _)
        if tmux has-session -t "=$name" 2>/dev/null; then
            session_path=$(tmux display-message -p -t "=$name" '#{session_path}')
            if [[ "$(realpath -m "$session_path")" != "$directory" ]]; then
                printf 'tsp: tmux session %s already points to %s\n' "$name" "$session_path" >&2
                exit 1
            fi
        else
            tmux new-session -d -s "$name" -c "$directory"
            env name="$name" directory="$directory" bash -c "$combined_hook"
        fi
        if [[ -n "${TMUX:-}" ]]; then
            exec tmux switch-client -t "=$name"
        fi
        exec tmux attach-session -t "=$name"
    fi
fi

exec tmux-session "${tmux_session_args[@]}" --hook "$combined_hook"
