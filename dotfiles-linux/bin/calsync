#!/usr/bin/env bash
set -euo pipefail

usage="Usage: $(basename "$0") [-q | --quiet] [-v | --verbose] [-h | --help] <davmail-config> <calendar-name> <org-file> <start> <stop>

Synchronize one vdirsyncer calendar with Outlook through DavMail and synchronize
that local calendar bidirectionally with an Org file through khalorg.

Options:
  -q, --quiet    suppress stdout and stderr
  -v, --verbose  also write errors to stderr
  -h, --help     show this help message
"

quiet=0
verbose=0
options=$(getopt -o qvh --long quiet,verbose,help -- "$@") || {
    echo "Incorrect options provided" >&2
    exit 2
}
eval set -- "$options"
while true; do
    case "$1" in
        -q | --quiet)
            quiet=1
            shift
            ;;
        -v | --verbose)
            verbose=1
            shift
            ;;
        -h | --help)
            echo "$usage"
            exit 0
            ;;
        --)
            shift
            break
            ;;
        *)
            echo "Internal option parser error" >&2
            exit 2
            ;;
    esac
done

if [[ $# -ne 5 ]]; then
    echo "Expected exactly five positional arguments." >&2
    echo "$usage" >&2
    exit 2
fi

davmail_config=$1
calendar=$2
org_file=$3
start=$4
stop=$5

if [[ ! $calendar =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]]; then
    echo "Invalid calendar name: $calendar" >&2
    exit 2
fi
if [[ $org_file == -* || $davmail_config == -* || $start == -* || $stop == -* ]]; then
    echo "Option-like positional values are not allowed." >&2
    exit 2
fi

state_home=${XDG_STATE_HOME:-$HOME/.local/state}
data_home=${XDG_DATA_HOME:-$HOME/.local/share}
khalorg_state_dir=$data_home/khalorg
mkdir -p "$state_home"
log_file=$state_home/calsync.log
if [[ -f $log_file ]] && (( $(wc -c < "$log_file") > 1048576 )); then
    tail -c 1048576 "$log_file" > "$log_file.tmp"
    mv "$log_file.tmp" "$log_file"
fi

lock_fd=

davmail_pid=
active_pid=

process_group_alive() {
    local pid=$1
    kill -0 -- "-$pid" 2>/dev/null
}

terminate_group_bounded() {
    local pid=$1
    [[ -n $pid ]] || return 0
    if process_group_alive "$pid"; then
        kill -TERM -- "-$pid" 2>/dev/null || true
        for _ in {1..20}; do
            process_group_alive "$pid" || break
            sleep 0.1
        done
    fi
    if process_group_alive "$pid"; then
        kill -KILL -- "-$pid" 2>/dev/null || true
    fi
    wait "$pid" 2>/dev/null || true
}

cleanup_children() {
    local stage_pid=$active_pid
    active_pid=
    terminate_group_bounded "$stage_pid"
    terminate_group_bounded "$davmail_pid"
    davmail_pid=
}

on_exit() {
    local status=$?
    trap - EXIT HUP INT TERM
    cleanup_children
    exit "$status"
}

on_signal() {
    local status=$1
    trap - EXIT HUP INT TERM
    cleanup_children
    exit "$status"
}

trap on_exit EXIT
trap 'on_signal 129' HUP
trap 'on_signal 130' INT
trap 'on_signal 143' TERM

run_stage() {
    local status
    setsid "$@" &
    active_pid=$!
    if wait "$active_pid"; then
        status=0
    else
        status=$?
    fi
    active_pid=
    return "$status"
}

acquire_lock() {
    exec {lock_fd}> "$state_home/calsync.lock"
    if ! flock -n "$lock_fd"; then
        echo "Another calendar sync is already running." >&2
        return 1
    fi
}

caldav_port() {
    local key value
    while IFS='=' read -r key value; do
        if [[ $key == davmail.caldavPort ]]; then
            [[ $value =~ ^[0-9]+$ ]] || return 1
            (( value >= 1 && value <= 65535 )) || return 1
            printf '%s\n' "$value"
            return 0
        fi
    done < "$davmail_config"
    return 1
}

port_has_listener() {
    local port=$1
    [[ -n $(ss -H -ltn "sport = :$port") ]]
}

owned_listener_ready() {
    local port=$1 socket_pid pgid pids
    pids=$(ss -H -ltnp "sport = :$port" 2>/dev/null \
        | grep -oE 'pid=[0-9]+' | cut -d= -f2 || true)
    for socket_pid in $pids; do
        pgid=$(ps -o pgid= -p "$socket_pid" 2>/dev/null) || continue
        pgid=${pgid//[[:space:]]/}
        [[ $pgid == "$davmail_pid" ]] && return 0
    done
    return 1
}

start_davmail() {
    local current_uid=$1 port
    if pgrep -u "$current_uid" -f 'davmail\.jar' >/dev/null; then
        echo "An unverified DavMail process is already running; refusing to reuse it." >&2
        return 1
    fi
    port=$(caldav_port) || {
        echo "Cannot read a valid davmail.caldavPort from $davmail_config" >&2
        return 1
    }
    if port_has_listener "$port"; then
        echo "DavMail port $port is already occupied; refusing to continue." >&2
        return 1
    fi

    setsid davmail "$davmail_config" &
    davmail_pid=$!
    for _ in {1..50}; do
        if ! kill -0 "$davmail_pid" 2>/dev/null; then
            echo "DavMail exited during startup." >&2
            return 1
        fi
        if owned_listener_ready "$port" \
            && nc -z -w 1 127.0.0.1 "$port" >/dev/null 2>&1; then
            return 0
        fi
        sleep 0.1
    done
    echo "DavMail listener on port $port did not become ready." >&2
    return 1
}

sync_calendar() {
    local current_uid
    acquire_lock
    current_uid=$(id -u) || return 1
    if ! ping -q -c 1 1.1.1.1 >/dev/null; then
        echo "No internet connection detected." >&2
        return 1
    fi

    start_davmail "$current_uid"
    run_stage vdirsyncer -v CRITICAL sync "$calendar"
    run_stage khalorg sync \
        --start "$start" \
        --stop "$stop" \
        --state-dir "$khalorg_state_dir" \
        --conflict-resolution khal \
        "$calendar" \
        "$org_file"
    run_stage vdirsyncer -v CRITICAL sync "$calendar"
    echo "Calendar sync done."
}

if [[ -n ${TMUX:-} ]] && command -v tmux >/dev/null; then
    tmux display-message -d 2000 "Calendar sync started"
else
    echo "Calendar sync started" >&2
fi

if (( quiet )); then
    sync_calendar >/dev/null 2>/dev/null
elif (( verbose )); then
    sync_calendar 2> >(tee -a "$log_file" >&2)
else
    sync_calendar 2>>"$log_file"
fi
