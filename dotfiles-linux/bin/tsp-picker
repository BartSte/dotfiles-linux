#!/usr/bin/env bash
set -euo pipefail

config=${TMUX_SESSION_DIRS_CONFIG:-"$HOME/.config/tmux-session/dirs"}
[[ -f "$config" ]] || {
    printf 'tsp-picker: config not found: %s\n' "$config" >&2
    exit 1
}

list_only=false
refresh=false
case "${1:-}" in
    --list) list_only=true; shift ;;
    --refresh) refresh=true; shift ;;
esac
if (($# > 1)); then
    printf 'Usage: tsp-picker [--list | --refresh] [PROJECT_DIRECTORY]\n' >&2
    exit 2
fi

list_projects() {
    local pattern root directory top_level main_directory project branch kind
    declare -A seen=()

    while IFS= read -r pattern || [[ -n "$pattern" ]]; do
        pattern=${pattern#"${pattern%%[![:space:]]*}"}
        pattern=${pattern%"${pattern##*[![:space:]]}"}
        [[ -z "$pattern" || "$pattern" == \#* ]] && continue

        if [[ "$pattern" == '~' ]]; then
            pattern=$HOME
        elif [[ "$pattern" == '~/'* ]]; then
            pattern=$HOME/${pattern#\~/}
        fi

        while IFS= read -r root; do
            [[ -d "$root" ]] || continue
            while IFS= read -r -d '' directory; do
                directory=$(realpath "$directory")
                [[ -e "$directory/.git" ]] || continue
                top_level=$(git -C "$directory" rev-parse --show-toplevel 2>/dev/null) || continue
                [[ "$(realpath "$top_level")" == "$directory" ]] || continue
                [[ -z "${seen[$directory]+x}" ]] || continue
                seen[$directory]=1

                project=$(basename "$directory")
                main_directory=$(git -C "$directory" worktree list --porcelain 2>/dev/null | sed -n '1s/^worktree //p')
                [[ -z "$main_directory" ]] || project=$(basename "$main_directory")
                branch=$(git -C "$directory" branch --show-current 2>/dev/null || true)
                [[ -n "$branch" ]] || branch='detached'

                kind=project
                if [[ -f "$directory/.git" ]]; then
                    kind=worktree
                fi
                printf '%s\t%s\t[%s] %s [%s]  %s\n' "$kind" "$directory" "$kind" "$project" "$branch" "$directory"
            done < <(find "$root" -maxdepth 3 -type d -print0 2>/dev/null)
        done < <(compgen -G "$pattern" || true)
    done < "$config"
}

cached_projects() (
    umask 077
    cache_directory=${XDG_CACHE_HOME:-"$HOME/.cache"}/tsp-picker
    # Include both the configuration location and its contents. HOME affects
    # expansion of the configured paths, so it also belongs in the key.
    cache_key=$({ printf 'v1\n%s\n%s\n' "$HOME" "$(realpath "$config")"; cat "$config"; } | sha256sum)
    cache_file="$cache_directory/${cache_key%% *}.tsv"
    if ! mkdir -p "$cache_directory"; then
        list_projects
        exit
    fi
    if ! $refresh && [[ -f "$cache_file" ]]; then
        cache_age=$(( $(date +%s) - $(stat -c %Y "$cache_file") ))
        if ((cache_age >= 0 && cache_age < 60)); then
            cat "$cache_file"
            exit
        fi
    fi

    temporary=$(mktemp "$cache_directory/.pending.XXXXXXXX")
    trap 'rm -f "$temporary"' EXIT
    # Keep writing the cache if fzf accepts early and closes its input pipe.
    # Publish only complete scans; concurrent scans use separate temporary files.
    list_projects | tee --output-error=warn-nopipe "$temporary"
    mv -f "$temporary" "$cache_file"
)

if $list_only; then
    list_projects
    exit 0
fi

if $refresh; then
    cached_projects
    exit 0
fi

printf -v refresh_command '%q --refresh' "$(realpath "${BASH_SOURCE[0]}")"
# fzf can accept a result before discovery finishes. A closed input pipe must
# not turn that successful selection into a pipeline failure.
selection=$(fzf --delimiter=$'\t' --with-nth=3 \
    --prompt='Project> ' --header='Enter: open repo/worktree  Ctrl-R: refresh  Esc: close' \
    --bind="ctrl-r:reload($refresh_command)" \
    < <(cached_projects)) || exit 0
[[ -n "$selection" ]] || exit 0
value=${selection#*$'\t'}
directory=${value%%$'\t'*}
if [[ ! -d "$directory" || ! -e "$directory/.git" ]]; then
    printf 'tsp-picker: directory no longer exists: %s; use Ctrl-R to refresh\n' "$directory" >&2
    exit 1
fi
printf '%s\n' "$directory"
