#!/usr/bin/env python3
"""Receive one JSON request over SSH. No input is evaluated as shell code."""
import json
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import tempfile
import uuid

MAX_BYTES = 2 * 1024 * 1024


def main():
    raw = sys.stdin.buffer.read(MAX_BYTES + 1)
    if len(raw) > MAX_BYTES:
        raise ValueError('The request exceeds the size limit.')
    request = json.loads(raw)
    if not isinstance(request, dict) or set(request) != {'version', 'action', 'calendar', 'request_id', 'org'}:
        raise ValueError('Invalid request fields.')
    if type(request['version']) is not int or request['version'] != 1:
        raise ValueError('Unsupported request version.')
    if request['action'] not in ('new', 'edit') or request['calendar'] not in ('outlook_personal', 'outlook_work'):
        raise ValueError('Only explicit new and edit requests are supported.')
    if not isinstance(request['org'], str) or str(uuid.UUID(request['request_id'])) != request['request_id']:
        raise ValueError('Invalid request identifier or event text.')
    state = Path(os.environ.get('XDG_STATE_HOME', str(Path.home()/'.local/state')))/'calendar-bridge'/'incoming'
    state.mkdir(parents=True, mode=0o700, exist_ok=True)
    script_dir = Path(__file__).resolve().parent
    calendar = request['calendar']
    profile = 'personal' if calendar == 'outlook_personal' else 'work'
    fd, name = tempfile.mkstemp(prefix='request-', suffix='.json', dir=state)
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(raw)
        command = [str(script_dir/'calsync'), '--verbose', '--request', name,
                   str(Path.home()/'.config/davmail'/('davmail.'+profile+'.properties')),
                   calendar, str(Path.home()/'dropbox/generated'/(calendar+'.org')), 'today', '365d']
        env = dict(os.environ, PATH=str(script_dir)+os.pathsep+os.environ.get('PATH', ''))
        child = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env, start_new_session=True)
        try:
            out, err = child.communicate(timeout=210)
        except subprocess.TimeoutExpired:
            os.killpg(child.pid, signal.SIGTERM)
            try:
                child.communicate(timeout=10)
            except subprocess.TimeoutExpired:
                os.killpg(child.pid, signal.SIGKILL)
                child.communicate()
            raise ValueError('Calendar synchronization timed out. Keep the pending request.') from None
        if child.returncode:
            # The backend emits bounded, plain errors. Do not print event payloads.
            print(err.decode(errors='replace')[-4000:], file=sys.stderr)
            return child.returncode
        result = json.loads(out)
        if (result.get('status') != 'confirmed_local' or result.get('calendar') != calendar
                or result.get('request_id') != request['request_id'] or not result.get('uid')
                or not re.fullmatch('[0-9a-f]{64}', result.get('baseline', ''))):
            raise ValueError('The server did not return a matching verified result.')
        # calsync returned zero only after push, another remote sync, verification,
        # and export. The private pending request remains the retry authority.
        result['status'] = 'confirmed'
        print(json.dumps(result))
        return 0
    finally:
        Path(name).unlink(missing_ok=True)


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (ValueError, TypeError, AttributeError, KeyError):
        print('Invalid or unconfirmed calendar request. Keep the pending draft.', file=sys.stderr)
        raise SystemExit(2)
    except Exception:
        print('Calendar submission failed. Keep the pending draft.', file=sys.stderr)
        raise SystemExit(1)
