#!/usr/bin/env bash
set -euo pipefail

for option in "$@"; do
    case "$option" in
        -q | --quiet | -v | --verbose | -h | --help) ;;
        *)
            echo "Unsupported mycalsync option: $option" >&2
            exit 2
            ;;
    esac
done

agenda_dir=${XDG_DATA_HOME:-$HOME/.local/share}/khalorg/agendas
mkdir -p "$agenda_dir"

calsync \
    "$HOME/.config/davmail/davmail.work.properties" \
    outlook_work \
    "$agenda_dir/outlook_work.org" \
    today 365d \
    "$@"

calsync \
    "$HOME/.config/davmail/davmail.personal.properties" \
    outlook_personal \
    "$agenda_dir/outlook_personal.org" \
    today 365d \
    "$@"
