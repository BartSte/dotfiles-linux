#!/usr/bin/env bash
set -euo pipefail

for option in "$@"; do
    case "$option" in
        -q | --quiet | -v | --verbose | -h | --help) ;;
        *)
            echo "Unsupported mycalsync option: $option" >&2
            exit 2
            ;;
    esac
done

mkdir -p "$HOME/dropbox/generated"

calsync \
    "$HOME/.config/davmail/davmail.work.properties" \
    outlook_work \
    "$HOME/dropbox/generated/outlook_work.org" \
    today 365d \
    "$@"

calsync \
    "$HOME/.config/davmail/davmail.personal.properties" \
    outlook_personal \
    "$HOME/dropbox/generated/outlook_personal.org" \
    today 365d \
    "$@"
