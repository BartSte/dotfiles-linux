#!/usr/bin/env bash
set -euo pipefail

config=${TMUX_SESSION_DIRS_CONFIG:-"$HOME/.config/tmux-session/dirs"}
resolve_only=false
prepare_only=false
expected_head=

usage() {
    cat <<'EOF'
Usage: tsp-pr [--config FILE] [--resolve-only | --prepare-only] [--expected-head SHA] OWNER/REPO PR BASE_BRANCH HEAD_BRANCH

Resolve a GitHub repository through the tmux-session dirs config and open
the pull request in a worktree with tsp. Repositories under ~/code/work or
~/code/personal use a worktrees folder beside the original repository.
Other repositories use ~/code/worktrees.
PR worktrees use <worktrees>/<project>/pr-<number>.
Fetch the PR head and fast-forward clean existing worktrees before opening.
With --expected-head, require that exact remote and checkout commit.
Stop automatic updates for local changes, unfinished operations, or divergence.
Local commits ahead of the PR remain available without --expected-head.
With --prepare-only, print the updated worktree path without opening tmux.
Progress output goes to stderr in this mode.
EOF
}

die() {
    printf 'tsp-pr: %s\n' "$*" >&2
    exit 1
}

while (($#)); do
    case "$1" in
        -c | --config)
            (($# >= 2)) || die "$1 requires a file"
            config=$2
            shift 2
            ;;
        --resolve-only)
            resolve_only=true
            shift
            ;;
        --prepare-only)
            prepare_only=true
            shift
            ;;
        --expected-head)
            (($# >= 2)) || die "$1 requires a commit SHA"
            expected_head=$2
            [[ "$expected_head" =~ ^[0-9a-f]{40}$ ]] || die "expected head must be a full commit SHA"
            shift 2
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*)
            die "unknown option: $1"
            ;;
        *)
            break
            ;;
    esac
done

(($# == 4)) || {
    usage >&2
    exit 2
}

repo=$1
pr_number=$2
base_branch=$3
head_branch=$4

[[ "$repo" == */* && "$repo" != */*/* ]] || die "repository must have the form OWNER/REPO"
[[ "$pr_number" =~ ^[0-9]+$ ]] || die "PR number must be numeric"
git check-ref-format --branch "$base_branch" >/dev/null 2>&1 || die "invalid base branch: $base_branch"
git check-ref-format --branch "$head_branch" >/dev/null 2>&1 || die "invalid head branch: $head_branch"
[[ -f "$config" ]] || die "tmux-session dirs config not found: $config"

normalize_repo() {
    local remote_url=$1
    local owner
    local owner_path
    local repository

    remote_url=${remote_url%/}
    remote_url=${remote_url%.git}

    if [[ "$remote_url" == *://* ]]; then
        remote_url=${remote_url#*://}
    elif [[ "$remote_url" == *@*:* ]]; then
        remote_url=${remote_url#*:}
    fi

    repository=${remote_url##*/}
    owner_path=${remote_url%/*}
    owner=${owner_path##*/}
    printf '%s/%s\n' "${owner,,}" "${repository,,}"
}

declare -a roots=()
while IFS= read -r pattern || [[ -n "$pattern" ]]; do
    pattern=${pattern#"${pattern%%[![:space:]]*}"}
    pattern=${pattern%"${pattern##*[![:space:]]}"}
    [[ -z "$pattern" || "$pattern" == \#* ]] && continue

    if [[ "$pattern" == "~" ]]; then
        pattern=$HOME
    elif [[ "$pattern" == "~/"* ]]; then
        pattern=$HOME/${pattern#\~/}
    fi

    while IFS= read -r root; do
        [[ -d "$root" ]] && roots+=("$root")
    done < <(compgen -G "$pattern" || true)
done < "$config"

((${#roots[@]})) || die "no directories matched $config"

declare -a candidates=()
declare -A seen=()
declare -A repository_remotes=()
wanted_repo=${repo,,}

while IFS= read -r -d '' git_marker; do
    directory=${git_marker%/.git}
    top_level=$(git -C "$directory" rev-parse --show-toplevel 2>/dev/null) || continue
    top_level=$(realpath "$top_level")
    directory=$(realpath "$directory")
    [[ "$top_level" == "$directory" ]] || continue

    directory=$(git -C "$directory" worktree list --porcelain | sed -n '1s/^worktree //p')
    directory=$(realpath "$directory")
    [[ -z "${seen[$directory]+x}" ]] || continue
    seen[$directory]=1

    while IFS= read -r remote; do
        remote_url=$(git -C "$directory" remote get-url "$remote" 2>/dev/null) || continue
        if [[ "$(normalize_repo "$remote_url")" == "$wanted_repo" ]]; then
            candidates+=("$directory")
            repository_remotes[$directory]=$remote
            break
        fi
    done < <(git -C "$directory" remote)
# A marker is one level below its repository. Do not scan Git internals or
# run Git in every source, dependency, and build directory.
done < <(find "${roots[@]}" -maxdepth 4 -name .git -print0 -prune 2>/dev/null)

((${#candidates[@]})) || die "no project for $repo found through $config"

current_root=$(git rev-parse --show-toplevel 2>/dev/null || true)
if [[ -n "$current_root" ]]; then
    current_root=$(git -C "$current_root" worktree list --porcelain | sed -n '1s/^worktree //p')
    current_root=$(realpath "$current_root")
fi

best_index=-1
best_score=-10000
best_ties=0
repo_directory_name=${repo##*/}

for index in "${!candidates[@]}"; do
    directory=${candidates[$index]}
    score=0

    if [[ "$directory" == "$current_root" ]]; then
        ((score += 1000))
    fi

    session_name=$(basename "$directory" | tr . _)
    session_path=$(tmux display-message -p -t "$session_name" '#{session_path}' 2>/dev/null || true)
    if [[ -n "$session_path" && "$(realpath -m "$session_path")" == "$directory" ]]; then
        ((score += 500))
    fi

    current_branch=$(git -C "$directory" branch --show-current)
    if [[ "$current_branch" == "$head_branch" ]]; then
        ((score += 200))
    elif git -C "$directory" show-ref --verify --quiet "refs/heads/$head_branch"; then
        ((score += 100))
    fi

    directory_name=${directory##*/}
    if [[ "${directory_name,,}" == "${repo_directory_name,,}" ]]; then
        ((score += 50))
    fi

    if [[ "$directory" == */debug/* ]]; then
        ((score -= 10))
    fi

    if ((score > best_score)); then
        best_index=$index
        best_score=$score
        best_ties=1
    elif ((score == best_score)); then
        ((best_ties += 1))
    fi
done

if ((best_ties > 1)); then
    printf 'tsp-pr: multiple projects match %s:\n' "$repo" >&2
    printf '  %s\n' "${candidates[@]}" >&2
    die "run the shortcut from the intended project once, or open its tmux session first"
fi

project_directory=${candidates[$best_index]}

if $resolve_only && $prepare_only; then
    die "--resolve-only and --prepare-only cannot be combined"
fi
if $resolve_only; then
    printf '%s\n' "$project_directory"
    exit 0
fi
if $prepare_only; then
    exec 3>&1
    exec 1>&2
fi

repository_remote=${repository_remotes[$project_directory]}
pr_reference="refs/pr-attention/$pr_number/head"
if ! git -C "$project_directory" fetch --no-tags --no-write-fetch-head -- "$repository_remote" \
    "+refs/pull/$pr_number/head:$pr_reference"; then
    die "cannot fetch $repo#$pr_number; the worktree was not updated"
fi
remote_head=$(git -C "$project_directory" rev-parse --verify "$pr_reference^{commit}")
if [[ -n "$expected_head" && "$remote_head" != "$expected_head" ]]; then
    die "PR head changed since the selected snapshot; refresh the queue before opening the worktree"
fi

update_worktree() {
    local directory=$1 actual_head changes operation operation_path
    actual_head=$(git -C "$directory" rev-parse HEAD)
    [[ "$actual_head" != "$remote_head" ]] || return 0

    if git -C "$directory" merge-base --is-ancestor "$remote_head" "$actual_head"; then
        [[ -z "$expected_head" ]] || die "local commits are ahead of the selected PR head: $directory"
        printf 'Keeping local commits ahead of %s#%s: %s\n' "$repo" "$pr_number" "$directory"
        return 0
    fi
    git -C "$directory" merge-base --is-ancestor "$actual_head" "$remote_head" ||
        die "worktree history diverged from the PR; inspect local commits or a force push: $directory"

    for operation in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply sequencer; do
        operation_path=$(git -C "$directory" rev-parse --path-format=absolute --git-path "$operation")
        [[ ! -e "$operation_path" ]] || die "finish the current Git operation before updating: $directory"
    done
    changes=$(git -C "$directory" status --porcelain --untracked-files=normal --ignore-submodules=none) ||
        die "cannot inspect worktree changes: $directory"
    [[ -z "$changes" ]] || die "commit or stash local changes before updating: $directory"

    printf 'Updating %s#%s (%s -> %s)\n' "$repo" "$pr_number" "${actual_head:0:8}" "${remote_head:0:8}"
    if ! git -C "$directory" -c submodule.recurse=false merge --ff-only --no-autostash --no-overwrite-ignore "$remote_head"; then
        die "cannot fast-forward the worktree; inspect the Git error: $directory"
    fi
}

worktree_root="$HOME/code/worktrees"
code_root=$(realpath -m "$HOME/code")
case "$project_directory" in
    "$code_root/work/"* | "$code_root/personal/"*)
        worktree_root="$(dirname "$project_directory")/worktrees"
        ;;
esac
project=${project_directory##*/}
worktree_directory="$worktree_root/$project/pr-$pr_number"
legacy_directory="$worktree_root/$project--pr-$pr_number"
if [[ ! -e "$worktree_directory" && -e "$legacy_directory" ]]; then
    worktree_directory=$legacy_directory
fi
worktree_branch=$head_branch

# A branch can only be checked out in one worktree, including the main one.
existing_worktree=""
while IFS= read -r -d '' field; do
    case "$field" in
        'worktree '*) existing_worktree=${field#worktree } ;;
        "branch refs/heads/$worktree_branch")
            worktree_directory=$existing_worktree
            break
            ;;
    esac
done < <(git -C "$project_directory" worktree list --porcelain -z)

if [[ -e "$worktree_directory" ]]; then
    worktree_top=$(git -C "$worktree_directory" rev-parse --show-toplevel 2>/dev/null || true)
    [[ -n "$worktree_top" && "$(realpath "$worktree_top")" == "$(realpath "$worktree_directory")" ]] ||
        die "destination is not a Git worktree: $worktree_directory"
    project_git=$(git -C "$project_directory" rev-parse --path-format=absolute --git-common-dir)
    worktree_git=$(git -C "$worktree_directory" rev-parse --path-format=absolute --git-common-dir)
    [[ "$(realpath "$project_git")" == "$(realpath "$worktree_git")" ]] ||
        die "destination belongs to another repository: $worktree_directory"
    current_branch=$(git -C "$worktree_directory" branch --show-current)
    [[ "$current_branch" == "$worktree_branch" || "$current_branch" == "pr-$pr_number" ]] ||
        die "destination is not on $worktree_branch: $worktree_directory"
    update_worktree "$worktree_directory"
    if [[ "$current_branch" == "pr-$pr_number" && "$current_branch" != "$worktree_branch" ]]; then
        git -C "$project_directory" show-ref --verify --quiet "refs/heads/$worktree_branch" &&
            die "branch $worktree_branch already exists; move the old PR worktree before retrying"
        # Rename legacy PR branches without discarding local commits or changes.
        git -C "$worktree_directory" branch -m "$worktree_branch"
        if ! (cd "$project_directory" && gh pr checkout "$pr_number" --repo "$repo" \
            --branch "$worktree_branch" --worktree "$worktree_directory"); then
            git -C "$worktree_directory" branch -m "$current_branch"
            die "PR checkout failed; the legacy branch name was restored"
        fi
    elif [[ "$current_branch" != "$worktree_branch" ]]; then
        die "destination is not on $worktree_branch: $worktree_directory"
    fi
else
    mkdir -p "$(dirname "$worktree_directory")"
    printf 'Fetching %s#%s (%s)\n' "$repo" "$pr_number" "$head_branch"
    (cd "$project_directory" && gh pr checkout "$pr_number" --repo "$repo" \
        --branch "$worktree_branch" --worktree "$worktree_directory")
    update_worktree "$worktree_directory"
fi

if [[ -n "$expected_head" ]]; then
    actual_head=$(git -C "$worktree_directory" rev-parse HEAD)
    if [[ "$actual_head" != "$expected_head" ]]; then
        printf 'tsp-pr: checkout head differs from the selected PR snapshot\n  Path: %s\n  Local: %s\n  Expected: %s\n' \
            "$worktree_directory" "$actual_head" "$expected_head" >&2
        die "the checkout does not match the selected head; inspect the worktree and refresh the PR queue"
    fi
fi

if $prepare_only; then
    printf '%s\n' "$worktree_directory" >&3
    exit 0
fi

session_name=$(basename "$worktree_directory" | tr . _)
if [[ "$(dirname "$worktree_directory")" == "$worktree_root/$project" ]]; then
    session_name=$(printf '%s--%s' "$project" "${worktree_directory##*/}" | tr . _)
fi
if tmux has-session -t "=$session_name" 2>/dev/null; then
    session_path=$(tmux display-message -p -t "=$session_name" '#{session_path}')
    [[ "$(realpath -m "$session_path")" == "$(realpath -m "$worktree_directory")" ]] ||
        die "tmux session $session_name already points to $session_path"
fi

exec tsp "$worktree_directory"
