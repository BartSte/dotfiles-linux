{
    "session": null,
    "window": 0,
    "index": 0,
    "reset": false,
    "logfile": null,
    "loglevel": null,
    "actions": [
        {
            "regex": "bash|zsh",
            "keys": [
                "nvim -c 'call cursor({1}, {2})' -- {3}",
                "Enter"
            ]
        },
        {
            "regex": "n?vim",
            "keys": [
                "Escape",
                ":execute 'edit ' . fnameescape({4}) | call cursor({1}, {2})",
                "Enter"
            ]
        },
        {
            "regex": "^codex$",
            "paste": "{0}"
        }
    ]
}
