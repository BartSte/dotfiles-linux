#!/usr/bin/env bash

set -eo pipefail

source ~/.zshenv

# Ensure zsh is installed
if ! command -v zsh &>/dev/null; then
  sudo apt-get update -y
  sudo apt-get install -y zsh
fi

# Set user shell to zsh
sudo chsh -s /usr/bin/zsh "$(whoami)"

# Set root shell to zsh
sudo chsh -s /usr/bin/zsh root

# Ensure history file exists. zsh settings are loaded only by .zshrc,
# so non-interactive installers must provide the same default explicitly.
HISTFILE="${HISTFILE:-$HOME/.histfile}"
touch "$HISTFILE"
